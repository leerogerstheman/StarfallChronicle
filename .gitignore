# Dependencies (the project has none, but a stray install should not be committed)
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Runtime / debug artifacts
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Test output
test/*.tmp
coverage/

# Native launcher build output. Reproducible with build-desktop.bat, and
# start.bat rebuilds it automatically on first run, so the binaries do not
# need to live in git. The WebView2 SDK sources ARE committed, under
# desktop/webview2-sdk/, so the build works offline on any Windows box.
desktop/bin/
*.pdb

# Editor
.vscode/
.idea/
*.swp
*~

# Release bundles are upload artefacts, not sources: the zip exists so a build
# can be attached to a GitHub release by hand, and it is derived entirely from
# `git ls-files` (see tools/make-release.ps1).
StarfallChronicle-v*.zip
